<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Client Health Scorecard — Solovis</title>
<style>
  :root {
    --green: #1e7a4c; --green-bg: #e6f4ec;
    --yellow: #9a6b00; --yellow-bg: #fdf3d8;
    --red: #b3261e; --red-bg: #fbe7e5;
    --ink: #1f2328; --muted: #57606a; --border: #d8dee4; --bg: #ffffff;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    color: var(--ink); background: #f6f8fa; margin: 0; padding: 32px 16px;
  }
  .wrap { max-width: 960px; margin: 0 auto; }
  header { margin-bottom: 28px; }
  header h1 { font-size: 22px; margin: 0 0 4px; }
  header p { color: var(--muted); margin: 0; font-size: 14px; }

  .rollup {
    display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 32px;
  }
  .stat {
    background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
    padding: 14px 18px; flex: 1; min-width: 140px;
  }
  .stat .num { font-size: 24px; font-weight: 600; }
  .stat .label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; }

  .band-pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .02em; }
  .band-green { background: var(--green-bg); color: var(--green); }
  .band-yellow { background: var(--yellow-bg); color: var(--yellow); }
  .band-red { background: var(--red-bg); color: var(--red); }

  .action-pill { display: inline-block; padding: 2px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; border: 1px solid var(--border); color: var(--muted); }
  .action-EXEC_ESCALATION { border-color: var(--red); color: var(--red); }
  .action-CSM_CHECK_IN { border-color: var(--yellow); color: var(--yellow); }
  .action-NO_ACTION { border-color: var(--green); color: var(--green); }

  .card {
    background: var(--bg); border: 1px solid var(--border); border-radius: 10px;
    padding: 20px 22px; margin-bottom: 16px;
  }
  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .card-top h2 { font-size: 17px; margin: 0 0 2px; }
  .card-top .meta { color: var(--muted); font-size: 13px; }
  .score-block { text-align: right; }
  .score-block .score { font-size: 26px; font-weight: 700; }
  .score-block .score-label { font-size: 11px; color: var(--muted); }

  .drivers { margin: 14px 0; font-size: 13px; color: var(--muted); }
  .drivers b { color: var(--ink); }

  .narrative { font-size: 14px; line-height: 1.55; margin: 14px 0 0; white-space: pre-line; }

  footer { margin-top: 32px; color: var(--muted); font-size: 12px; text-align: center; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Client Health Scorecard</h1>
    <p>Sample synthetic portfolio — generated {{ generated_at }}</p>
  </header>

  <div class="rollup">
    <div class="stat"><div class="num">{{ rollup.total_accounts }}</div><div class="label">Accounts</div></div>
    <div class="stat"><div class="num">{{ rollup.avg_health_score }}</div><div class="label">Avg health score</div></div>
    <div class="stat"><div class="num">{{ rollup.band_counts.red }}</div><div class="label">Red</div></div>
    <div class="stat"><div class="num">{{ rollup.band_counts.yellow }}</div><div class="label">Yellow</div></div>
    <div class="stat"><div class="num">{{ rollup.band_counts.green }}</div><div class="label">Green</div></div>
  </div>

  {% for r in results %}
  <div class="card">
    <div class="card-top">
      <div>
        <h2>{{ r.account_name }}</h2>
        <div class="meta">{{ r.plan_tier }} · {{ r.primary_contact_name }} · renewal in {{ r.structured.days_to_renewal }} days</div>
      </div>
      <div class="score-block">
        <div class="score">{{ r.health_score }}</div>
        <div class="score-label">HEALTH SCORE</div>
        <div style="margin-top:6px;">
          <span class="band-pill band-{{ r.band }}">{{ r.band }}</span>
          <span class="action-pill action-{{ r.action_recommendation }}">{{ r.action_recommendation.replace('_', ' ') }}</span>
        </div>
      </div>
    </div>
    <div class="drivers">
      <b>Top drivers:</b>
      {% for name, pts in r.top_drivers %}{{ name.replace('_', ' ') }} ({{ "%.1f"|format(pts) }} pts){% if not loop.last %}, {% endif %}{% endfor %}
    </div>
    <div class="narrative">{{ r.narrative }}</div>
  </div>
  {% endfor %}

  <footer>Internal CSM/leadership prep aid — not client-facing. Recommendations are surfaced for human review, not auto-executed.</footer>
</div>
</body>
</html>
